# All variables are optional. Defaults are shown.
# Server
TXSTORY_HOST=127.0.0.1
TXSTORY_PORT=8787
# live: real providers. recorded: only saved fixtures are served (offline, deterministic).
TXSTORY_MODE=live
# Directory with the built client (set automatically to dist/client when present).
# TXSTORY_STATIC_DIR=dist/client
TXSTORY_FIXTURES_DIR=fixtures/synthetic,fixtures/devnet

# Providers. A comma-separated list REPLACES the public defaults for that chain.
# URLs may contain credentials; they are redacted from logs and source records.
# TXSTORY_RPC_ETHEREUM=https://your-ethereum-rpc,https://fallback-rpc
# TXSTORY_RPC_OPTIMISM=
# TXSTORY_RPC_BASE=
# TXSTORY_RPC_ARBITRUM=
# Blockscout v2 API base per chain, or "off" to disable explorer enrichment.
# TXSTORY_EXPLORER_ETHEREUM=https://eth.blockscout.com
# TXSTORY_EXPLORER_BASE=off
# Optional Blockscout API key (sent as ?apikey=, redacted everywhere).
# TXSTORY_BLOCKSCOUT_API_KEY=

# Limits
TXSTORY_MAX_EXPLORER_PAGES=6
TXSTORY_MAX_TOKEN_METADATA=30
TXSTORY_TIMEOUT_MS=15000
# Explorer state changes / internal transactions are slow to compute (12 to 20 s measured).
TXSTORY_SLOW_EXPLORER_TIMEOUT_MS=45000
TXSTORY_MAX_RESPONSE_BYTES=8000000
TXSTORY_RATE_LIMIT_PER_MINUTE=30
TXSTORY_GLOBAL_RATE_LIMIT_PER_MINUTE=300
TXSTORY_CACHE_TTL_MS=600000
TXSTORY_CACHE_MAX_MB=64

# Reverse proxies. Default: trust no forwarding header (identity = TCP peer).
# Set to EXACTLY your proxy's address/range: loopback, private, IPs or CIDRs.
# TXSTORY_TRUST_PROXY=172.30.53.2

# Concurrency and time budgets for story builds
TXSTORY_MAX_CONCURRENT_FAST=8
TXSTORY_MAX_CONCURRENT_FULL=6
TXSTORY_MAX_CONCURRENT_PER_CLIENT=2
TXSTORY_SLOT_WAIT_MS=10000
TXSTORY_FAST_BUDGET_MS=35000
TXSTORY_FULL_BUDGET_MS=90000

# Operations
TXSTORY_SHUTDOWN_GRACE_MS=8000
# One JSON line per API request (no client IPs, hashes or provider URLs). 0 disables.
TXSTORY_LOG_REQUESTS=1

# Analysis
# auto: request debug_traceTransaction (callTracer) in the full stage, trying each RPC in order. off: never.
TXSTORY_TRACE=auto
# Add networks (e.g. a local devnet) from a JSON chain file; see docs/extending.md.
# TXSTORY_CHAINS_FILE=chains.json
