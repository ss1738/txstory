{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": "dist/node",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/core", "src/engine", "src/server", "src/cli"]
}
