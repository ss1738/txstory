# Copy to deploy/pilot.env on the VM (chmod 600, owner root). Never commit pilot.env.
# All values are optional; defaults are the public endpoints listed in README.

# Your own RPC endpoints (recommended; public ones are best-effort). May contain keys:
# TXSTORY_RPC_ETHEREUM=https://<provider>/<key>
# TXSTORY_RPC_OPTIMISM=
# TXSTORY_RPC_BASE=
# TXSTORY_RPC_ARBITRUM=
# Optional Blockscout API key (raises explorer rate limits):
# TXSTORY_BLOCKSCOUT_API_KEY=

# Admission control (defaults shown). Pilot traffic is small; the global ceiling
# protects upstream providers.
# TXSTORY_RATE_LIMIT_PER_MINUTE=30
# TXSTORY_GLOBAL_RATE_LIMIT_PER_MINUTE=300
# TXSTORY_MAX_CONCURRENT_FAST=8
# TXSTORY_MAX_CONCURRENT_FULL=6
# TXSTORY_MAX_CONCURRENT_PER_CLIENT=2
# TXSTORY_SLOT_WAIT_MS=10000
# TXSTORY_FAST_BUDGET_MS=35000
# TXSTORY_FULL_BUDGET_MS=90000
# TXSTORY_CACHE_MAX_MB=64
